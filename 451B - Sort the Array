#include<bits/stdc++.h>
using namespace std;

int main(){
   int n,pivot = 0,l=0;
   cin>>n;
   vector<int> arr(n);
   for(auto &i:arr)cin>>i;
   int count = 0;
   for(int i =1 ;i<n-1;i++){
       if(arr[i-1]>arr[i+1] && arr[i-1]>arr[i] && arr[i+1]>arr[i]){
           cout<<"no";
           return 0;
       }
       else if((arr[i-1]<arr[i] && arr[i]>arr[i+1]) || (arr[i-1]>arr[i] && arr[i]<arr[i+1])){
           count++;
          if(count == 2){
              l = pivot;
          }
           pivot = i;
       }
   }
   int st;
   
   if(pivot == 0){
        cout<<"yes"<<endl;
       if(n==1 || arr[0]<arr[n-1])cout<<1<<" "<<1;
       else cout<<1<<" "<<n;
       return 0;
   }
    if(arr[pivot-1]>arr[pivot]){  
        st = pivot;
        while(st>0 && arr[st-1]>arr[st])st--;
        if(st!=0 && arr[st-1]>arr[st] || (st!=l && l!=0 && (arr[l]<arr[l-1] || arr[l]>arr[l+1]))){
          cout<<"no";
          return 0;
        }
        cout<<"yes"<<endl;
        cout<<st+1<<" "<<pivot+1;
    }  
    else {
        st = pivot;
        while(st<n-1 && arr[st+1]<arr[st])st++;
         if(pivot!=0 && arr[pivot-1]>arr[st] || (st!=l && l!=0 && (arr[l]<arr[l-1] || arr[l]>arr[l+1]))){
          cout<<"no";
          return 0;
        }
        cout<<"yes"<<endl;
        cout<<pivot+1<<" "<<st+1;
    }
}
